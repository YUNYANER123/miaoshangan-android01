<?xml version="1.0" encoding="utf-8"?>
<!-- 倒数日组件的一行（2 个 / 4 个组件共用，由 WidgetRender 通过 RemoteViews.addView 动态添加）
     v1.53n：字号放大 + layout_weight 均分高度，尽量占满组件，解决上下留白大；
     圆角底色由 Java 端 setBackgroundResource(圆角 drawable) 设置，不再用 setBackgroundColor 直角块。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cd_row_root"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:minHeight="36dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:paddingStart="11dp"
    android:paddingEnd="11dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/cd_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏳"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/cd_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E3A5F"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cd_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#6B8299"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/cd_dnum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2F80ED"
        android:gravity="end" />

    <TextView
        android:id="@+id/cd_dunit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="天后"
        android:textSize="11sp"
        android:textColor="#6B8299"
        android:paddingStart="2dp" />
</LinearLayout>
