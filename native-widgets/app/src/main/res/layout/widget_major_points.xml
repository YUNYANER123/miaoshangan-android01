<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_cat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐱"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="专业课知识点"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E3A5F"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="6dp" />
        <TextView
            android:id="@+id/w_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#6B8299" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/mp_counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#2F80ED" />
        <TextView
            android:id="@+id/mp_book"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#6B8299" />
        <TextView
            android:id="@+id/mp_t"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1E3A5F" />
        <TextView
            android:id="@+id/mp_c"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#27496B" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/mp_next" style="@style/WidgetBtn" android:text="下一个" />
            <Button android:id="@+id/mp_fav" style="@style/WidgetBtn" android:text="★ 收藏" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="点 🐱 进 App"
        android:textSize="10sp"
        android:textColor="#6B8299"
        android:gravity="center"
        android:paddingTop="2dp" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text=""
        android:textSize="13sp"
        android:textColor="#6B8299"
        android:visibility="gone" />
</LinearLayout>
