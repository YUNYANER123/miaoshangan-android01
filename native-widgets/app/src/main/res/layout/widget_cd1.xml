<?xml version="1.0" encoding="utf-8"?>
<!-- 倒数日（1 个）：2×2 小组件。头部只留 🐱 + 名称，中间大号天数，底部一行日期。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_cat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐱"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="倒数日"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#1E3A5F"
            android:singleLine="true"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="5dp" />
        <TextView
            android:id="@+id/w_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="9sp"
            android:textColor="#6B8299"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/cd_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/cd_dnum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#2F80ED"
                android:gravity="center" />

            <TextView
                android:id="@+id/cd_dunit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="天后"
                android:textSize="9sp"
                android:textColor="#6B8299"
                android:paddingStart="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/cd_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="9sp"
            android:textColor="#6B8299"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text=""
        android:textSize="11sp"
        android:textColor="#6B8299"
        android:visibility="gone" />
</LinearLayout>
