<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_cat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐱"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="背单词"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1E3A5F"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="6dp" />
        <TextView
            android:id="@+id/w_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="10sp"
            android:textColor="#6B8299" />
        <TextView
            android:id="@+id/w_fav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☆"
            android:textSize="18sp"
            android:textColor="#9AA7B5"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="6dp"
            android:paddingEnd="2dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1E3A5F" />
        <TextView
            android:id="@+id/w_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="10sp"
            android:textColor="#6B8299" />
        <TextView
            android:id="@+id/w_mean"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#27496B" />
        <TextView
            android:id="@+id/w_stat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="10sp"
            android:textColor="#6B8299" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp">
            <Button android:id="@+id/w_prev" style="@style/WidgetBtn" android:text="上一个" />
            <Button android:id="@+id/w_reveal" style="@style/WidgetBtn" android:text="显示释义" />
            <Button android:id="@+id/w_learned" style="@style/WidgetBtn" android:text="标记已背" />
            <Button android:id="@+id/w_next" style="@style/WidgetBtn" android:text="下一个" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="点 🐱 进 App · 点释义看中文"
        android:textSize="10sp"
        android:textColor="#6B8299"
        android:gravity="center"
        android:paddingTop="2dp" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text=""
        android:textSize="13sp"
        android:textColor="#6B8299"
        android:visibility="gone" />
</LinearLayout>
